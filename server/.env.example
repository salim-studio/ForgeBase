# ── ForgeBase server ── copy to .env and fill in ──
PORT=8080

# Auth (set a long random string in production!)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES=7d

# Database: unset = local SQLite file. Set to use Postgres:
# DATABASE_URL=postgres://forge:forge@localhost:5432/forgebase
SQLITE_PATH=./data/forgebase.db

# File uploads (local disk; S3-compatible via STORAGE_* below)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
# Optional S3-compatible backend (any S3 API: MinIO, R2, AWS):
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=auto
# S3_BUCKET=forgebase
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# AI proxy (server-side only — NEVER exposed to the browser)
# AI_PROVIDER=openai-compatible
# AI_MODEL=gpt-4o-mini
# AI_ENDPOINT=https://api.openai.com/v1
# AI_API_KEY=
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=2048

# CORS (frontend origin when served separately; same-origin needs nothing)
# CORS_ORIGIN=http://localhost:8080
